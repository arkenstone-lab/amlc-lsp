+(* A form name immediately followed by [()] is the compiler's direct-call
+   syntax.  We only emit spans for forms confirmed by [Parse.forms], avoiding
+   free identifiers and comments entirely. *)
+let occurrence_spans raw kind name =
+  if not (String.equal kind "form") then [] else
+  match Lex.scan raw with
+  | Error _ -> []
+  | Ok items ->
+      let rec collect found index =
+        if index + 1 >= Array.length items then List.rev found
+        else
+          match items.(index).Lex.tok, items.(index + 1).Lex.tok with
+          | Lex.Form, Lex.Ident found_name when String.equal found_name name ->
+              collect (("declaration", items.(index + 1).Lex.span) :: found) (index + 1)
+          | Lex.Ident found_name, Lex.Lparen when String.equal found_name name ->
+              collect (("reference", items.(index).Lex.span) :: found) (index + 1)
+          | _ -> collect found (index + 1)
+      in
+      collect [] 0
+
