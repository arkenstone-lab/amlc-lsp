+let json_escape value =
+  let buffer = Buffer.create (String.length value + 8) in
+  String.iter
+    (function
+      | '"' -> Buffer.add_string buffer "\\\""
+      | '\\' -> Buffer.add_string buffer "\\\\"
+      | '\n' -> Buffer.add_string buffer "\\n"
+      | '\r' -> Buffer.add_string buffer "\\r"
+      | '\t' -> Buffer.add_string buffer "\\t"
+      | value -> Buffer.add_char buffer value)
+    value;
+  Buffer.contents buffer
+
+type source_range = { first : int; last : int }
+
+let mask_range source range =
+  let out = Bytes.of_string source in
+  for index = range.first to range.last - 1 do
+    if Bytes.get out index <> '\n' then Bytes.set out index ' '
+  done;
+  Bytes.unsafe_to_string out
+
+let form_ranges source =
+  match Octra_vm.C_lex.scan source with
+  | Error _ -> []
+  | Ok items ->
+      let close first last ranges = match first with None -> ranges | Some first -> { first; last } :: ranges in
+      let rec walk index depth first ranges =
+        if index = Array.length items then List.rev (close first (String.length source) ranges)
+        else
+          let item = items.(index) in
+          let token = item.Octra_vm.C_lex.tok in
+          match token with
+          | Octra_vm.C_lex.Form when depth = 1 ->
+              walk (index + 1) depth (Some item.span.first.off) (close first item.span.first.off ranges)
+          | Octra_vm.C_lex.Term when depth = 1 ->
+              List.rev (close first item.span.first.off ranges)
+          | Octra_vm.C_lex.Lbrace -> walk (index + 1) (depth + 1) first ranges
+          | Octra_vm.C_lex.Rbrace -> walk (index + 1) (depth - 1) first ranges
+          | _ -> walk (index + 1) depth first ranges
+      in
+      walk 0 0 None []
+
+let parse_with_form_recovery source =
+  let rec collect source ranges errors =
+    match Parse.parse source with
+    | Ok parsed -> List.rev errors, Some parsed
+    | Error error ->
+        match List.find_opt (fun range -> range.first <= error.span.first.off && error.span.first.off <= range.last) ranges with
+        | Some range -> collect (mask_range source range) (List.filter (fun item -> item <> range) ranges) (error :: errors)
+        | None -> List.rev (error :: errors), None
+  in
+  collect source (form_ranges source) []
+
+let check_json path =
+  let emit (span : Octra_vm.C_lex.span) message =
+    Printf.printf
+      "{\"message\":\"%s\",\"severity\":\"error\",\"start\":{\"line\":%d,\"column\":%d,\"offset\":%d},\"end\":{\"line\":%d,\"column\":%d,\"offset\":%d}}\n%!"
+      (json_escape message) span.first.line span.first.col span.first.off
+      span.last.line span.last.col span.last.off
+  in
+  let raw = source path in
+  match Octra_vm.C_lex.diagnostics raw with
+  | _ :: _ as errors ->
+      List.iter (fun error -> emit error.Octra_vm.C_lex.span (Octra_vm.C_lex.text error)) errors;
+      exit 1
+  | [] ->
+      let errors, parsed = parse_with_form_recovery raw in
+      if errors <> [] then begin
+        List.iter (fun error -> emit error.Parse.span (Parse.text error)) errors;
+        exit 1
+      end;
+      match parsed with
+      | None -> failwith "parser recovery lost a successful parse"
+      | Some parsed ->
+          begin
+            match Parse.diagnostics parsed with
+            | [] -> ()
+            | errors ->
+                List.iter (fun error -> emit error.Parse.span (Parse.text error)) errors;
+                exit 1
+          end
+
