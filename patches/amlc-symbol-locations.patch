+(* The parser confirms which top-level declarations exist.  The same compiler
+   lexer supplies their exact source spans, so editor navigation never relies
+   on a separate text search. *)
+let selection_span raw kind name =
+  match Lex.scan raw with
+  | Error _ -> None
+  | Ok items ->
+      let rec find index =
+        if index + 1 >= Array.length items then None
+        else
+          match items.(index).Lex.tok, items.(index + 1).Lex.tok with
+          | Lex.Program, Lex.Ident found when String.equal kind "program"
+                                                && String.equal name found ->
+              Some items.(index + 1).Lex.span
+          | Lex.Form, Lex.Ident found when String.equal kind "form"
+                                             && String.equal name found ->
+              Some items.(index + 1).Lex.span
+          | _ -> find (index + 1)
+      in
+      find 0
+
