{
  "name": "appliedml",
  "displayName": "AppliedML LSP",
  "description": "Language Server Protocol support for Applied Meta Language (AppliedML), powered by amlc-lsp",
  "version": "0.3.1",
  "publisher": "arkenstone-labs",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkenstone-lab/amlc-lsp.git"
  },
  "homepage": "https://github.com/arkenstone-lab/amlc-lsp#readme",
  "bugs": {
    "url": "https://github.com/arkenstone-lab/amlc-lsp/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "appliedml",
    "amlc",
    "octra",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:appliedml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "icon.png",
    "syntaxes/**",
    "language-configuration.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "appliedml",
        "aliases": [
          "AppliedML",
          "Applied Meta Language"
        ],
        "extensions": [
          ".aml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "appliedml",
        "scopeName": "source.appliedml",
        "path": "./syntaxes/appliedml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "appliedml.restartServer",
        "title": "AppliedML: Restart Language Server"
      },
      {
        "command": "appliedml.showServerInformation",
        "title": "AppliedML: Show Server Information"
      }
    ],
    "configuration": {
      "title": "AppliedML",
      "properties": {
        "amlcLsp.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to amlc-lsp. When empty, the extension resolves amlc-lsp from PATH."
        },
        "amlcLsp.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Additional command-line arguments passed to amlc-lsp."
        },
        "amlcLsp.server.environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "machine-overridable",
          "description": "Environment variables added when starting amlc-lsp."
        },
        "amlcLsp.dialect": {
          "type": "string",
          "enum": [
            "auto",
            "appliedml",
            "legacy"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Compiler syntax selection. Auto detects the syntax from top-level declarations."
        },
        "amlcLsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace messages exchanged with amlc-lsp in the AppliedML output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "package": "npm run check && esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "compile-tests": "tsc -p test/tsconfig.json",
    "check": "tsc --noEmit -p .",
    "test": "npm run compile && npm run compile-tests && node out-test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "vscode-languageclient": "^9.0.1",
    "typescript": "^5.9.2"
  }
}
