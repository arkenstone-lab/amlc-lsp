#!/usr/bin/env sh
set -eu

root_version=$(sed -n 's/^(version \(.*\))$/\1/p' dune-project)
opam_version=$(sed -n 's/^version: "\(.*\)"$/\1/p' amlc-lsp.opam)
grammar_version=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' package.json | head -1)
tree_sitter_version=$(sed -n 's/^[[:space:]]*"version": "\(.*\)",$/\1/p' tree-sitter.json | head -1)
zed_extension_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' zed/extension.toml)
zed_crate_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' zed/Cargo.toml | head -1)
zed_server_version=$(sed -n 's/^const SERVER_VERSION: &str = "\([^"]*\)";$/\1/p' zed/src/lib.rs)
zed_lock_version=$(awk '
  /^name = "zed-aml"$/ { in_crate = 1; next }
  in_crate && /^version = / { gsub(/"/, "", $3); print $3; exit }
' zed/Cargo.lock)
vscode_extension_version=$(sed -n 's/^[[:space:]]*"version": "\([^"]*\)",$/\1/p' vscode/package.json | head -1)
server_version=$(sed -n 's/.*("serverInfo".*("version", `String "\([^"]*\)").*/\1/p' lib/amlc_lsp.ml)
nix_version=$(awk '
  /amlcLsp =/ { in_lsp = 1 }
  in_lsp && /^[[:space:]]*version = / {
    match($0, /"[^"]+"/)
    print substr($0, RSTART + 1, RLENGTH - 2)
    exit
  }
' flake.nix)
opam_amlc_rev=$(sed -n 's@.*amlc.git#\([0-9a-f][0-9a-f]*\)".*@\1@p' amlc-lsp.opam)
nix_amlc_rev=$(awk '
  /amlcSrc =/ { in_amlc = 1 }
  in_amlc && /^[[:space:]]*rev = / {
    match($0, /"[^"]+"/)
    print substr($0, RSTART + 1, RLENGTH - 2)
    exit
  }
' flake.nix)
vscode_installer_package=$(sed -n 's/^const serverPackage = "\([^"]*\)";$/\1/p' vscode/src/opamInstaller.ts)
nvim_installer_package=$(sed -n 's/^local server_package = "\([^"]*\)"$/\1/p' nvim/lua/amlc_lsp/opam.lua)
vscode_installer_rev=$(sed -n 's@.*amlc-lsp.git#\([0-9a-f][0-9a-f]*\).*@\1@p' vscode/src/opamInstaller.ts)
nvim_installer_rev=$(sed -n 's@.*amlc-lsp.git#\([0-9a-f][0-9a-f]*\).*@\1@p' nvim/lua/amlc_lsp/opam.lua)
opam_amlc_version=$(sed -n 's/.*"amlc" {= "\([^"]*\)"}.*/\1/p' amlc-lsp.opam)
vscode_installer_amlc=$(sed -n 's/^const requiredAmlcVersion = "\([^"]*\)";$/\1/p' vscode/src/opamInstaller.ts)
nvim_installer_amlc=$(sed -n 's/^local required_amlc_version = "\([^"]*\)"$/\1/p' nvim/lua/amlc_lsp/opam.lua)

test -n "$root_version"
for candidate in "$opam_version" "$grammar_version" "$tree_sitter_version" "$zed_extension_version" "$zed_crate_version" "$zed_lock_version" "$zed_server_version" "$nix_version" "$server_version"; do
  test "$candidate" = "$root_version" || {
    printf 'version mismatch: expected %s, found %s\n' "$root_version" "$candidate" >&2
    exit 1
  }
done

root_release_line=${root_version%.*}
vscode_release_line=${vscode_extension_version%.*}
test "$vscode_release_line" = "$root_release_line" || {
  printf 'VS Code extension release-line mismatch: expected %s.x, found %s\n' "$root_release_line" "$vscode_extension_version" >&2
  exit 1
}

test -n "$opam_amlc_rev"
test "$opam_amlc_rev" = "$nix_amlc_rev" || {
  printf 'AMLC revision mismatch: OPAM pins %s, Nix pins %s\n' "$opam_amlc_rev" "$nix_amlc_rev" >&2
  exit 1
}

installer_package="amlc-lsp.$root_version"
for candidate in "$vscode_installer_package" "$nvim_installer_package"; do
  test "$candidate" = "$installer_package" || {
    printf 'editor installer package mismatch: expected %s, found %s\n' "$installer_package" "$candidate" >&2
    exit 1
  }
done
test -n "$vscode_installer_rev"
test "$vscode_installer_rev" = "$nvim_installer_rev" || {
  printf 'editor installer source mismatch: VS Code uses %s, Neovim uses %s\n' "$vscode_installer_rev" "$nvim_installer_rev" >&2
  exit 1
}
for candidate in "$vscode_installer_amlc" "$nvim_installer_amlc"; do
  test "$candidate" = "$opam_amlc_version" || {
    printf 'editor installer AMLC mismatch: expected %s, found %s\n' "$opam_amlc_version" "$candidate" >&2
    exit 1
  }
done

printf 'server manifests use %s; VS Code extension %s is compatible\n' "$root_version" "$vscode_extension_version"
